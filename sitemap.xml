---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
{% assign post_urls = site.posts | where_exp: 'post', 'post.sitemap != false' | map: 'url' -%}
{%- assign page_urls = site.html_pages | where_exp: 'entry', 'entry.sitemap != false' | map: 'url' -%}
{%- assign static_urls = site.static_files | where: 'extname', '.html' | map: 'path' -%}
{%- assign published_urls = page_urls | concat: post_urls | concat: static_urls | uniq | sort -%}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    {%- for url in published_urls -%}
        {%- assign canonical_path = url | replace: '/index.html', '/' -%}
        {%- if url == '/404.html' -%}
            {%- continue -%}
        {%- endif -%}
        {%- if canonical_path != url and published_urls contains canonical_path -%}
            {%- continue -%}
        {%- endif %}
    <url><loc>{{ canonical_path | absolute_url | xml_escape }}</loc></url>
    {%- endfor %}
</urlset>
